    "@glyph3d/core": "workspace:*",
    "@glyph3d/r3f": "workspace:*",
    "@react-three/fiber": "^9.0.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^6.6.1",
    "fzf": "^0.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
