# Dependencies
node_modules/
package-lock.json

# Build output
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp
.claude/worktrees/

# Data
examples/word-wall/generated_dictionary/
examples/word-wall/data/
coordinates.csv
__pycache__/

# Go CLI build output + dependencies
cli/glyph3d-cli
cli/.claude/scheduled_tasks.lock
cli/web/

# Single-binary build
glyph3d-cli
# The terminal daemon and its client, copied beside glyph3d-cli by `make termd`
/g3d-termd
/g3d

# Prebaked slug-core asset — generated by `make bake-core` (tools/bake-slug-core.mjs),
# content-addressed + deterministic, so it's regenerated at build, not committed.
app/public/slug-core/

# Per-workspace saved session (SessionStore writes this via the relay)
.glyph3d-session.json

# Browser console capture (dev aid)
console.log
# Agent state stays local (worktrees live in .claude/worktrees); the project skills are shared.
.claude/*
!.claude/skills/
.glyph3d/

# Check runner output (tools/check.mjs): last-run.json, kept failures, its Vite cache
/out/

# Perf ledger rows (tools/perf-ledger.mjs): this machine's measurements, never committed
/perf/

# Rust workspace build output and vendored libghostty/zig (tools/termd-vendor.sh, run by make termd)
/target/
/vendor
