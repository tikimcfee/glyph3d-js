{
  "name": "glyph3d-js",
  "version": "0.1.0",
  "description": "High-performance 3D text rendering for Three.js using GPU-instanced glyphs",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./collections": "./src/collections/index.js",
    "./workers": "./src/workers/WorkerBridge.js",
    "./utils": "./src/utils/index.js",
    "./hand": "./src/hand/index.js"
  },
  "files": [
    "src",
    "examples"
  ],
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "ws": "node examples/github-viewer/ws-relay.mjs",
    "ws:py": "python3 examples/github-viewer/ws-relay.py",
    "relay": "node examples/github-viewer/ws-relay.mjs",
    "cli": "node examples/github-viewer/cli/glyph-cli.mjs"
  },
  "keywords": [
    "three.js",
    "threejs",
    "webgl",
    "text",
    "3d",
    "glyph",
    "instancing",
    "gpu",
    "rendering",
    "font",
    "atlas"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/glyph3d-js.git"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "three": "^0.169.0",
    "ws": "^8.19.0"
  }
}
